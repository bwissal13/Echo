<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="0015-1" author="system">
        <!-- Add soft delete columns to books table -->
        <addColumn tableName="books">
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp"/>
            <column name="permanent_delete_at" type="timestamp"/>
        </addColumn>
    </changeSet>

    <changeSet id="0015-2" author="system">
        <!-- Add soft delete columns to chapters table -->
        <addColumn tableName="chapters">
            <column name="deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp"/>
            <column name="permanent_delete_at" type="timestamp"/>
        </addColumn>
    </changeSet>

</databaseChangeLog> 